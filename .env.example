# ==============================================================================
# LayoverIQ — Environment Configuration Template
# "Smart decisions between flights."
# ==============================================================================

# Application Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# JWT Secret for User Authentication
JWT_SECRET=layoveriq_super_secret_jwt_key_2026_devops_lab

# Database Connection URI (Optional: If empty, LayoverIQ uses built-in In-Memory / Local Storage Store)
MONGODB_URI=mongodb://localhost:27017/layoveriq

# Optional External AI Assistant API Key (OpenAI / Gemini / Anthropic)
# If left empty, LayoverIQ automatically uses the built-in Intelligent Local Rule/NLP Engine
AI_API_KEY=
AI_PROVIDER=local_fallback

# Optional External Weather API Key (OpenWeatherMap)
# If left empty, LayoverIQ automatically uses high-accuracy real-time simulated city climatology
WEATHER_API_KEY=

# Optional Mapbox / Google Maps API Key
# If left empty, LayoverIQ uses OpenStreetMap / Leaflet tiles with built-in routing geometry
MAP_API_KEY=
