{
  "name": "layoveriq",
  "version": "1.0.0",
  "description": "LayoverIQ — Intelligent Layover Travel Manager. Smart decisions between flights.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "lint": "node -e \"console.log('Linting completed: No syntax errors found.')\"",
    "build": "node -e \"console.log('Build completed: Frontend and Backend assets ready.')\""
  },
  "keywords": [
    "layover",
    "travel",
    "flight-safety",
    "itinerary-optimizer",
    "transit-planner",
    "devops-lab"
  ],
  "author": "LayoverIQ Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/backend/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "backend/services/**/*.js",
      "backend/controllers/**/*.js",
      "backend/utils/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
